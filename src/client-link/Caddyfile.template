{
    http_port 8080
    https_port 8443
    servers {
        listener_wrappers {
            proxy_protocol
            tls
        }
    }
}

$LINK_DOMAIN {
    handle /.well-known/fractalnetworks/health {
	    respond "OK" 200
	}

    # optional basic authentication
    $BASIC_AUTH_CONFIG

    # optional tls: mounted cert (TLS_CERT_FILE) or internal (TLS_INTERNAL), else ACME
    $TLS_INTERNAL_CONFIG

    reverse_proxy $EXPOSE

}
